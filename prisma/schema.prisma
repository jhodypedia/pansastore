generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  USER
}

enum PremifyStatus {
  PENDING
  PROCESSING
  SUCCESS
  COMPLETED
  FAILED
  CANCELLED
}


enum PremifyStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  id                 Int      @id @default(1)
  pakasirApiKey      String?  @db.Text
  pakasirProjectSlug String?  @db.Text
  premifyApiKey      String?  @db.Text
  globalMarkup       Float    @default(0)
  isRegisterOpen     Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model Product {
  id          String    @id
  name        String
  category    String?
  description String?   @db.Text
  imageUrl    String?   @db.Text
  basePrice   Float
  markupValue Float     @default(0)
  sellPrice   Float
  type        String?
  stock       Int       @default(0)
  updatedAt   DateTime  @updatedAt

  variants    Variant[]
}

model Variant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  name      String
  duration  String
  type      String
  warranty  String
  price     Float
  stock     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model Transaction {
  id             Int           @id @default(autoincrement())
  invoiceId      String        @unique
  premifyOrderId String?
  productCode    String
  customerPhone  String
  amount         Float
  paymentStatus  PaymentStatus @default(PENDING)
  premifyStatus  PremifyStatus @default(PENDING)
  productDetails String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([paymentStatus, createdAt])
}
