generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  id             Int      @id @default(1)
  dompetxApiKey  String?  @db.Text
  premifyApiKey  String?  @db.Text
  globalMarkup   Float    @default(0)
  isRegisterOpen Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model Product {
  id          String    @id
  name        String
  category    String?
  description String?   @db.Text
  imageUrl    String?   @db.Text
  basePrice   Float
  markupValue Float     @default(0)
  sellPrice   Float
  type        String?
  stock       Int       @default(0)
  updatedAt   DateTime  @updatedAt

  // Relasi ke Variant
  variants    Variant[]
}

model Variant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  name      String           // contoh: "1 Bulan", "3 Bulan", "1 Tahun"
  duration  String           // contoh: "30 Hari", "90 Hari", "365 Hari"
  type      String           // contoh: "Private", "Sharing"
  warranty  String           // contoh: "30 Hari", "Full"
  price     Float
  stock     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Index untuk mempercepat query berdasarkan produk
  @@index([productId])
}

model Transaction {
  id             Int      @id @default(autoincrement())
  invoiceId      String   @unique
  premifyOrderId String?
  productCode    String
  customerPhone  String
  amount         Float
  paymentStatus  String   @default("PENDING")
  premifyStatus  String   @default("PENDING")
  productDetails String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}